# ─────────────────────────────────────────────────────────────────────────────
# BookHead AI – Development Environment Variables
# NOTE: Never commit production `.env` to version control.

# Why we need .env file? What big problem it solves?
# Need: At different level of application building - from development, to staging, to production,
#       we use several variables and their values that sets the configuration of our application.
#       We can simply use a .env file for each level with different values of variables as per our
#       need. This way we can manage configuartion settings for each level, that with ease.
#       Using .env file Pydantic Settings model, where all the fields of Settings model get their 
#       values from .env file is clean and scalable method for each level. It takes of the burden of
#       changing variables directly in config.py file.
#
# BIG PROBLEM IT SOLVES:    Code/Image  ←   separated from   →  Runtime Configuration of Container
# -> If we hard code all the environment variables in config.py file then, those variables also 
# -> gets tranferred into docker image and becomes immutable. Now for everytime any change is to be 
# -> done with respect to settings, we need to change config.py rebuilt the image and then deploy it.
# -> .env file along with Pydantic Settings Model solves this very problem. It allows to provide a .env
# -> file on container start up and the values for environment variables will be fetched from .env file.
# -> This way we able to separate Image state from Runtime container state.
# -> Highly extendable and extremely clean.

# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# "development" | "production"
ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Anthropic LLM ────────────────────────────────────────────────────────────
# Your Anthropic API key {needed only when Large LLM is used}
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-new-era
# ANTHROPIC_MAX_TOKENS=2048

# ── Gemma-2B LLM : light weight LLM with on system inference ──────────────
# Path to gemma-2b-it.Q4_K_M.gguf Model
GEMMA_MODEL_PATH=/app/models/llama/gemma-2b-it.Q4_K_M.gguf
# Model Context Window
GEMMA_N_CTX=1024
# Number of threads to be used for inference
GEMMA_N_THREAD=4
# Number of input prompt tokens to be processed internally by model
GEMMA_N_BATCH=256
# Number of model layers to be offloaded to GPU
GEMMA_N_GPU_LAYERS=0

# Configs for Text Summarization Task:
# Max tokens that model generates on inference 
GEMMA_MAX_TOKENS=160
# Temperture param for Gemma LLM
GEMMA_LLM_TEMP=0.9

# Path to stored genre_embeddings file. Ex: /app/models/genre_embeddings.npy
# Generate and store them.
EMBEDDING_MODEL_PATH=/app/models/all-MiniLM-L6-v2
GENRE_SAVED_EMBEDDINGS_FILE_PATH=/app/models/saved_genre_embeddings/genre_embeddings.npy


# ── Redis (Celery broker + result backend + session cache) ───────────────────
REDIS_URL=redis://localhost:6379/0

# Redis TTL for HITL review sessions in seconds (def - 24hrs)
REVIEW_SESSION_TTL_SECONDS=86400

# ── Qdrant vector database ───────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME_READER=books
QDRANT_COLLECTION_NAME_LIBRARIAN=library_books

# Similarity score above which Qdrant hit is a cache hit
QDRANT_SIMILARITY_THRESHOLD=0.92
# Sentence-transformers model for book 'title+author' embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2


# ── OCR ──────────────────────────────────────────────────────────────────────
# Minimum confidence score (0.0–1.0) below which a book is flagged for review
OCR_CONFIDENCE_THRESHOLD=0.75
# Comma-separated list of languages EasyOCR will attempt
OCR_LANGUAGES=en

OCR_DEVICE=cpu
DETECTOR_THRESHOLD=0.1
DETECTOR_BOX_THRESHOLD=0.3
DETECTOR_UNCLIP_RATIO=1.8

# After text region detection using PaddleOCR TextDetection. We need to filter out text boxes which
# are very close to image borders. "min_box_distance_px" tells the minimum distance the text region
# must maintain
MIN_BOX_DISTANCE_PX=5

# Parameter for tunning filtearation of recognised texts from text recognition results
# keeping text which is recognised with good confidence score
MIN_CONF_THRESH_TEXT_REC=0.7

# Google Books API for accessing book data based on OCR extracted text
# MUST! Create and provide your own API Key
GOOGLE_BOOKS_API_KEY=put-your-own-generated-key-here

# Use GPU for EasyOCR inference (requires CUDA-enabled machine)
OCR_GPU=False

# Preprocessing toggles — disable individual steps for debugging
OCR_PREPROCESS_UPSCALE=True
# PaddleOCR is great with unprocessed simple RGB images
OCR_PREPROCESS_ORIENTATION=False
# & No need for normalising orientationa
OCR_PREPROCESS_THRESHOLD=False


# ── Object detection ─────────────────────────────────────────────────────────
# Path to custom Faster-RCNN weights or pre-downloaded model for faster loading; 
# leave blank to use torchvision pretrained - "fasterrcnn_resnet50_fpn_v2_coco" model
DETECTION_MODEL_WEIGHTS=/app/models/faster-rcnn-model/fasterrcnn_resnet50_fpn_v2_coco-dd69338a.pth

# Minimum Faster-RCNN score to keep a detection (0.0–1.0)
DETECTION_THRESHOLD=0.70

# IoU threshold for Non-Maximum Suppression
DETECTION_NMS_IOU_THRESHOLD=0.40

# width to height difference of bounding box around detected book must be greater than "200" for it be a legit book crop
WIDTH_TO_HEIGHT_DIFF_OF_BOOK=200

# Padding to be applied around detected bounding box before crop from original image
PADDING_AROUND_BOOK_CROP=2

# PyTorch device: "cpu" or "cuda"
DETECTION_DEVICE=cpu


# ── File storage ─────────────────────────────────────────────────────────────
# Directory where uploaded images and crop files are saved
UPLOAD_DIR=/app/uploads
# Maximum upload file size in bytes (default: 20 MB)
MAX_UPLOAD_SIZE_BYTES=20971520


# ── Portfolio Website Link ────────────────────────────────────────────────────
PORTFOLIO_URL=https://www.vishalm.online

# ─────────────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────
